{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.1"
    }
  ],
  "routes": [
    {
      "src": "^/(css/.*|js/.*|assets/.*|uploads/.*|favicon\\.png|favicon\\.svg|robots\\.txt)$",
      "dest": "/$1"
    },
    {
      "src": "^/.*$",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "MODO_DEBUG": "false"
  }
}
