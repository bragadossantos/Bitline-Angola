{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.png",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(css/.*|js/.*|assets/.*|uploads/.*|favicon\\.png|favicon\\.svg|robots\\.txt)$",
      "dest": "/$1"
    },
    {
      "src": "^/.*$",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "MODO_DEBUG": "false"
  }
}
